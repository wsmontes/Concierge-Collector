FROM node:22.18.0-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/admin/package.json apps/admin/package.json
COPY packages/fastapi-client/package.json packages/fastapi-client/package.json
RUN npm ci --include=dev --legacy-peer-deps
COPY . ./

# Payload config is evaluated by next build. These non-secret placeholders are
# only for compilation; Render replaces every operational value at runtime.
ENV CMS_MONGODB_URL=mongodb://placeholder.invalid:27017 \
    CMS_MONGODB_DB_NAME=concierge-cms \
    CMS_SERVICE_KEY=build-only-cms-service-key \
    CMS_PUBLIC_SERVER_URL=https://admin.concierge-collector.com \
    FASTAPI_BASE_URL=https://api.concierge-collector.com \
    METRICS_KEY=build-only-metrics-key \
    PAYLOAD_SECRET=build-only-payload-secret-at-least-32-chars

# Cliente de contratos: apps/admin (catalog-client, curation-adapter) importa
# '@concierge/fastapi-client', cujo `exports` aponta para ./dist/index.js. Esse
# dist é GERADO (não versionado) e o .dockerignore exclui `dist`, então ele
# precisa ser produzido aqui — sem este passo o build do Render falhava com
# "Module not found: Can't resolve '@concierge/fastapi-client'".
# O gerador lê o snapshot versionado contracts/openapi/fastapi-admin-internal.v1.json,
# então não depende de Python nem do FastAPI durante o build.
RUN npm run generate --workspace=@concierge/fastapi-client \
 && npm run build --workspace=@concierge/fastapi-client

RUN npm run build --workspace=@concierge/admin

FROM node:22.18.0-bookworm-slim AS runtime
ENV NODE_ENV=production
# `next start` lê PORT do ambiente — não repassar a porta como argumento.
# `npm run start:admin -- --port N` NÃO chega ao next: sem o separador `--` na
# camada interna (o script é `npm run start --workspace=…`), o npm consome a
# flag e o valor vira argumento posicional, gerando
# `next start --hostname 0.0.0.0 10000` → "Invalid project directory provided,
# no such directory: /app/apps/admin/10000". Esse foi o boot que falhou no
# Render. Render injeta PORT; 10000 é o default para uso local.
ENV PORT=10000

WORKDIR /app
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/admin ./apps/admin
COPY --from=build /app/packages ./packages

EXPOSE 10000
CMD ["npm", "run", "start:admin"]
