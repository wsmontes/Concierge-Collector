CMS_MONGODB_URL=mongodb://127.0.0.1:27017
CMS_MONGODB_DB_NAME=concierge-cms
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
CMS_PUBLIC_SERVER_URL=http://localhost:3000
# Comma-separated origins of Collector deployments allowed to call future CMS APIs.
CMS_COLLECTOR_ORIGINS=http://localhost:8080
FASTAPI_BASE_URL=http://localhost:8000
CMS_SERVICE_KEY=replace-with-a-distinct-rotatable-service-credential
# Dedicated key for /metrics. It must not match API/JWT/CMS service secrets.
METRICS_KEY=replace-with-a-distinct-observability-credential
