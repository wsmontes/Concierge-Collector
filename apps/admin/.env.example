CMS_MONGODB_URL=mongodb://127.0.0.1:27017
CMS_MONGODB_DB_NAME=concierge-cms
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
CMS_PUBLIC_SERVER_URL=http://localhost:3000
# Comma-separated origins of Collector deployments allowed to call future CMS APIs.
CMS_COLLECTOR_ORIGINS=http://localhost:8080
FASTAPI_BASE_URL=http://localhost:8000
CMS_SERVICE_KEY=replace-with-a-distinct-rotatable-service-credential
# Dedicated key for /metrics. It must not match API/JWT/CMS service secrets.
METRICS_KEY=replace-with-a-distinct-observability-credential

# Worker recovery. The maintenance reconciler only reopens the SAME Payload job
# when its domain lease is reclaimable and the Payload job is provably stuck.
# It never reconstructs a missing job automatically.
CMS_JOB_RECOVERY_STALE_SECONDS=180
CMS_JOB_MAX_RECOVERIES=3
# Staged draft rows are deleted only after this age AND only when the owning
# operation is terminal or absent. Any nonterminal operation protects staging.
CMS_ORPHAN_STAGING_RETENTION_DAYS=30
CMS_ORPHAN_STAGING_BATCH_SIZE=500

# Private object storage for selection exports (lazy: only the export route/job
# read these, and the service fails closed with 503 while they are absent).
# The bucket must be PRIVATE and the principal prefix-scoped to PutObject,
# GetObject, AbortMultipartUpload, ListBucketMultipartUploads and DeleteObject;
# uploads never set an ACL and reads only happen via short-lived signed URLs.
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=concierge-exports
S3_ACCESS_KEY_ID=replace-with-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-storage-secret-key
S3_FORCE_PATH_STYLE=false
S3_EXPORT_PREFIX=cms/exports
# Seconds a presigned read URL stays valid (short TTL; the GET endpoint issues a
# fresh URL per read).
S3_SIGNED_URL_TTL_SECONDS=300
# Seconds the export artifact and its CMS reference stay alive (604800 = 7 days
# in staging).
EXPORT_ARTIFACT_TTL_SECONDS=604800