CMS_MONGODB_URL=mongodb://127.0.0.1:27017
CMS_MONGODB_DB_NAME=concierge-cms
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
CMS_PUBLIC_SERVER_URL=http://localhost:3000
# Comma-separated origins of Collector deployments allowed to call CMS APIs.
CMS_COLLECTOR_ORIGINS=http://localhost:8080
FASTAPI_BASE_URL=http://localhost:8000
CMS_SERVICE_KEY=replace-with-a-distinct-rotatable-service-credential
# Dedicated key for /metrics. It must not match API/JWT/CMS service secrets.
METRICS_KEY=replace-with-a-distinct-observability-credential

# Worker recovery. The maintenance reconciler only reopens the SAME Payload job
# when its domain lease is reclaimable and the Payload job is provably stuck.
# It never reconstructs a missing job automatically. Invalid numeric overrides
# fail closed instead of silently reverting to defaults.
CMS_JOB_RECOVERY_STALE_SECONDS=180
CMS_JOB_MAX_RECOVERIES=3

# Staged draft rows are deleted only after this age AND only when the owning
# operation is terminal or absent. Any nonterminal operation protects staging.
# Cleanup is an indexed, eligibility-first bounded hourly scan.
CMS_ORPHAN_STAGING_RETENTION_DAYS=30
CMS_ORPHAN_STAGING_BATCH_SIZE=500

# High-cardinality operation-item detail is compacted only for terminal
# child/single operations older than this window. Aggregate multi-target parents
# never own item rows. The parent keeps deterministic counts + SHA-256 before
# item deletion; evidence is hashed through a bounded cursor.
CMS_OPERATION_ITEM_RETENTION_DAYS=90
CMS_OPERATION_ITEM_BATCH_SIZE=100

# Selection intent validity stays 24h. Once a ready selection is consumed by a
# bulk operation/export, only deletion retention is extended; validity is NOT.
CMS_USED_SELECTION_RETENTION_DAYS=90

# Private object storage for selection exports and worker-only audit archives
# (lazy: only the export/maintenance paths read these variables). The bucket
# must be PRIVATE and the principal prefix-scoped to PutObject, GetObject,
# AbortMultipartUpload, ListBucketMultipartUploads and DeleteObject; uploads
# never set an ACL and authorized export reads use short-lived signed URLs.
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=concierge-exports
S3_ACCESS_KEY_ID=replace-with-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-storage-secret-key
S3_FORCE_PATH_STYLE=false
S3_EXPORT_PREFIX=cms/exports
# Seconds a presigned export read URL stays valid. The effective URL lifetime is
# also capped by the export record's absolute expiresAt.
S3_SIGNED_URL_TTL_SECONDS=300
# Seconds a newly created export remains eligible for download before the
# maintenance worker performs object-first deletion (604800 = 7 days).
EXPORT_ARTIFACT_TTL_SECONDS=604800
# Bounded hourly cleanup of expired completed/failed export references.
CMS_EXPORT_PURGE_BATCH_SIZE=100

# Admin audit events remain hot for one year by default. Older events are
# written as deterministic private NDJSON-gzip, manifested with count/SHA, and
# only then deleted from the hot CMS collection. No TTL is used for audit rows.
# One bounded archival batch runs each hour.
CMS_AUDIT_RETENTION_DAYS=365
CMS_AUDIT_ARCHIVE_BATCH_SIZE=1000

# Chaos/recovery qualification is intentionally NOT a production setting.
# Only set these in disposable *-test environments while running the harness:
# CONCIERGE_ALLOW_REMOTE_CHAOS=1
# CONCIERGE_CHAOS_WORKER_STOPPED=1
# CONCIERGE_CHAOS_ENVIRONMENT=staging
