                  "$ref": "#/components/schemas/CmsAuthorization"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "CmsServiceKey": []
          }
        ],
        "summary": "Introspect",
        "tags": [
          "cms-auth"
        ]
      }
    },
