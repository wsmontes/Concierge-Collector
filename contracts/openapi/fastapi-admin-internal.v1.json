        "description": "A bounded, explicitly chosen set of Curations to resolve.",
        "properties": {
          "curation_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 500,
            "minItems": 1,
            "title": "Curation Ids",
            "type": "array"
          }
        },
        "required": [
          "curation_ids"
