      "post": {
        "description": "Revalidate a Collector Bearer for the narrow CMS bridge.\n\nThis is not a general token exchange: it accepts only an interactive\nsession and only returns a currently authorized admin identity.",
        "operationId": "introspect_bearer_api_v3_auth_cms_introspect_bearer_post",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CmsAuthorization"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "CmsServiceKey": [],
            "HTTPBearer": []
          },
          {
            "CmsServiceKey": [],
            "FastApiAccessCookie": []
          }
        ],
        "summary": "Introspect Bearer",
        "tags": [
          "cms-auth"
        ]
      }
    },
