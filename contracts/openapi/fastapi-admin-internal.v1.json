    "securitySchemes": {
      "CmsServiceKey": {
        "in": "header",
        "name": "X-CMS-Service-Key",
        "type": "apiKey"
      },
      "FastApiAccessCookie": {
        "in": "cookie",
        "name": "access_token",
        "type": "apiKey"
      },
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Professional async API with MongoDB support for entity and curation management",
    "title": "Concierge Collector API V3",
    "version": "3.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v3/auth/cms/authorize": {
      "get": {
        "description": "Issue a one-shot code for a current admin and redirect to the fixed CMS callback.",
        "operationId": "authorize_api_v3_auth_cms_authorize_get",
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "required": true,
            "schema": {
              "maxLength": 2048,
              "minLength": 1,
              "title": "State",
              "type": "string"
            }
          }
        ],
        "responses": {
          "307": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "FastApiAccessCookie": []
          }
        ],
        "summary": "Authorize",
        "tags": [
          "cms-auth"
        ]
      }
    },
    "/api/v3/auth/cms/exchange": {
      "post": {
        "description": "Atomically consume a one-shot code on behalf of the CMS server.",
        "operationId": "exchange_api_v3_auth_cms_exchange_post",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CmsExchangeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CmsAuthorization"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "CmsServiceKey": []
          }
        ],
        "summary": "Exchange",
        "tags": [
          "cms-auth"
        ]
      }
    },
    "/api/v3/auth/cms/introspect": {
      "post": {
        "description": "Return the live authorization for an already-authenticated CMS subject.",
        "operationId": "introspect_api_v3_auth_cms_introspect_post",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CmsIntrospectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
